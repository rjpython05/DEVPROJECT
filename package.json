{
  "name": "devproject-monday-app",
  "version": "1.0.0",
  "description": "Sistema de Gestión de Proyectos de Desarrollo - Monday.com App (PMBOK 7ma Edición)",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/app.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/app.js",
    "tunnel": "mapps tunnel:create -p 8080",
    "deploy": "npm run build && mapps code:push",
    "provision": "tsx src/server/scripts/provision.ts",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@mondaycom/apps-sdk": "^3.0.11",
    "@mondaydotcomorg/api": "^7.0.1",
    "@vibe/core": "^3.83.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "monday-sdk-js": "^0.5.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@mondaycom/apps-cli": "^4.9.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^6.2.2"
  }
}
